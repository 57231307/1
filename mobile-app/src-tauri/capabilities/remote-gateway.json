{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-gateway",
  "description": "允许用户所填的任意部署站点 origin 调用 app 命令：回弹 gateway（登录失败）与安卓蓝牙打印桥。首装时部署域未知，故按 http/https 通配并覆盖任意端口；仅暴露这些命令，不开放文件/网络等敏感能力。",
  "windows": ["main"],
  "remote": {
    "urls": ["http://*", "https://*", "http://*:*", "https://*:*"]
  },
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-remember-gateway",
    "allow-reopen-gateway",
    "allow-bluetooth-request-permission",
    "allow-bluetooth-open-settings",
    "allow-bluetooth-list-printers",
    "allow-bluetooth-connect",
    "allow-bluetooth-print-text",
    "allow-bluetooth-disconnect"
  ]
}
