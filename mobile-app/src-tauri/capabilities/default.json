{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "内置 gateway（服务器地址设置页，本地 origin）：可调用核心与 app 命令（gateway 记录与回弹、安卓蓝牙打印桥）。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-remember-gateway",
    "allow-reopen-gateway",
    "allow-bluetooth-request-permission",
    "allow-bluetooth-open-settings",
    "allow-bluetooth-list-printers",
    "allow-bluetooth-connect",
    "allow-bluetooth-print-text",
    "allow-bluetooth-disconnect"
  ]
}
